# Klucz Erlanga wymagany do komunikacji między node’ami RabbitMQ w klastrze.
# Musi być identyczny na wszystkich kontenerach RabbitMQ.
RABBITMQ_ERL_COOKIE=secret_cookie

# Gdzie RabbitMQ ma wysyłać logi.
# "-" oznacza logowanie do stdout (docker logs).
RABBITMQ_LOGS=-

# Lista pluginów RabbitMQ do włączenia przy starcie.
# "rabbitmq_management" daje dostęp do panelu WWW (port 15672) i REST API.
RABBITMQ_PLUGINS=rabbitmq_management

# Czy zezwolić na dostęp do RabbitMQ Management UI przez HTTP.
# true = włączony dostęp przez przeglądarkę.
RABBITMQ_MANAGEMENT_ALLOW_WEB_ACCESS=true

# Ostrzeżenie o przepełnionej przestrzeni dyskowej - uruchomienie ostrzeżenia traci wszystkie nadchodzące wiadomości do kolejki
RABBITMQ_DISK_FREE_RELATIVE_LIMIT=0.01
